# OpenRouter API Configuration for TeachBack AI
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary Model (Recommended: fast, high context, reasoning)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Fallback Model in case primary model hits rate limit or quota
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Firebase Authentication Configuration (Get from Firebase Console -> Project Settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id


